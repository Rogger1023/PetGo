
# Modelo de configuração do PetGo
# Nunca adicionar credenciais reais neste arquivo.

# Laravel
APP_KEY=base64:COLE_A_CHAVE_GERADA_AQUI

# Docker Compose
COMPOSE_PROJECT_NAME=petgo

APP_ENV=local
APP_DEBUG=true

# Porta externa do proxy Nginx
PROXY_PORT=80

# Banco de dados MySQL
DB_NAME=petgo
DB_USER=petgo_app
DB_PASSWORD=SENHA_DO_PETGO_APP
DB_ROOT_PASSWORD=SENHA_DO_ROOT
